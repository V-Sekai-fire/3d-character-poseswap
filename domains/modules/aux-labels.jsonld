{
 "@context": {
  "VSEKAI": "https://v-sekai.org/",
  "domain": "VSEKAI:planning/domain/"
 },
 "@type": "domain:Module",
 "name": "aux-labels",
 "module": {
  "summary": "Part labels for a garment: relabel the COCO set, make the synthetic set, train the detector, ingest the mesh into USD, unitise, label with Segment, restore units."
 },
 "variables": [
  {
   "name": "input",
   "type": "int",
   "description": "1 when an input is on hand: a double-precision Godot editor, the packet golden file, the MuJoCo guest, the 100 Hz clips, the ANNY base mesh, the SOMA phenotype data, the built ANNY fit guest ELF, the OmniGen2 guest ELF built with only the mul_mat op, the full OmniGen2 guest ELF, a free GPU host, an edit prompt; for the AUX route: a Fashionpedia-class COCO set, the GarmentCodeData drapes, the Segment weights, SAM 3 and DINOv3 weights checked against their pinned SHA-256, a host C++ compiler the CUDA toolkit accepts, a body motion clip, a portrait.",
   "init": {
    "gpu": 0,
    "garment_image": 0,
    "birefnet_weights": 0,
    "pixal3d_weights": 0
   }
  },
  {
   "name": "aux",
   "type": "int",
   "description": "1 when a step of the AUX part-labelling and rigging route is done: coco_relabelled, synth_set, part_detector, unit_cube_source, part_labels, warp_built, motion_lag, hair_cards, spring_chains, scale_sidecar; composites labelled_parts, soft_rigid_known and rigged; also usd_stage (the source ingested into OpenUSD in its own units) and metric_labels (Segment's labels put back on the real-size stage by restore-units).",
   "init": {}
  }
 ],
 "actions": {
  "relabel-coco": {
   "params": [],
   "body": [
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/input/coco_set",
      "value": 1
     }
    },
    {
     "pointer/set": "/aux/coco_relabelled",
     "value": 1
    }
   ],
   "duration": "PT7.81S",
   "duration_basis": "measured: warm median 7.81 s of 5 runs, to the millisecond; the first run took 7.907 s. Wall clock of tools/aux.sh action relabel-coco on fedora, which includes process and model start-up",
   "measured": {
    "runs_s": [
     7.907,
     7.864,
     7.83,
     7.796,
     7.81,
     7.796
    ],
    "host": "node-1w7jr9qmdnujmtqxifhewsfsn.ipv6.telus.net, RTX 4090, tools/measure/time_actions.py, 2026-11-15"
   },
   "description": "Map every source class of the Fashionpedia-class set into Skirt, Sleeve, Collar, Cape, Accessory, Fitted and Detail with a motion prior.",
   "description_basis": "written: the sentence the domain description gives for this action"
  },
  "make-synth-set": {
   "params": [],
   "body": [
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/input/gcd_drapes",
      "value": 1
     }
    },
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/input/gpu_host",
      "value": 1
     }
    },
    {
     "pointer/set": "/aux/synth_set",
     "value": 1
    }
   ],
   "duration": "PT8M32S",
   "duration_basis": "measured: 360 garments on fedora, 2026-11-15",
   "description": "Render GarmentCodeData drapes on the neutral body into a COCO set with exact part masks, split by garment (repro/gen_synth.py).",
   "description_basis": "written: the sentence the domain description gives for this action"
  },
  "train-part-detector": {
   "params": [],
   "body": [
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/input/gpu",
      "value": 1
     }
    },
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/aux/coco_relabelled",
      "value": 1
     }
    },
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/aux/synth_set",
      "value": 1
     }
    },
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/input/gpu_host",
      "value": 1
     }
    },
    {
     "pointer/set": "/aux/part_detector",
     "value": 1
    },
    {
     "pointer/set": "/input/gpu",
     "value": 1
    }
   ],
   "duration": "PT19M24S",
   "duration_basis": "measured: 15 epochs on the 3-class set, one RTX 4090",
   "description": "Fine-tune RF-DETR-Seg-Small on the relabelled and the synthetic sets (repro/train_synth.py).",
   "description_basis": "written: the sentence the domain description gives for this action"
  },
  "unitise-source": {
   "params": [],
   "body": [
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/aux/usd_stage",
      "value": 1
     }
    },
    {
     "pointer/set": "/aux/unit_cube_source",
     "value": 1
    }
   ],
   "duration": "PT0.698S",
   "duration_basis": "measured: warm median 0.698 s of 5 runs, to the millisecond; the first run took 0.693 s. Wall clock of tools/aux.sh action unitise-source on fedora, which includes process and model start-up",
   "measured": {
    "runs_s": [
     0.693,
     0.699,
     0.696,
     0.698,
     0.71,
     0.698
    ],
    "host": "node-1w7jr9qmdnujmtqxifhewsfsn.ipv6.telus.net, RTX 4090, tools/measure/time_actions.py, 2026-11-15"
   },
   "description": "Normalise the source GLB into the unit cube before Segment.",
   "description_basis": "written: the sentence the domain description gives for this action"
  },
  "write-scale-sidecar": {
   "params": [],
   "body": [
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/aux/unit_cube_source",
      "value": 1
     }
    },
    {
     "pointer/set": "/aux/scale_sidecar",
     "value": 1
    }
   ],
   "duration": "PT0.423S",
   "duration_basis": "measured: warm median 0.423 s of 5 runs, to the millisecond; the first run took 0.434 s. Wall clock of tools/aux.sh action write-scale-sidecar on fedora, which includes process and model start-up",
   "measured": {
    "runs_s": [
     0.434,
     0.423,
     0.427,
     0.423,
     0.422,
     0.423
    ],
    "host": "node-1w7jr9qmdnujmtqxifhewsfsn.ipv6.telus.net, RTX 4090, tools/measure/time_actions.py, 2026-11-15"
   },
   "description": "Write scale and offset beside every unit-cube mesh, with the metric size from a body-height prior.",
   "description_basis": "written: the sentence the domain description gives for this action"
  },
  "segment-labels": {
   "params": [],
   "body": [
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/input/gpu",
      "value": 1
     }
    },
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/aux/part_detector",
      "value": 1
     }
    },
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/aux/unit_cube_source",
      "value": 1
     }
    },
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/input/segment_weights",
      "value": 1
     }
    },
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/input/gpu_host",
      "value": 1
     }
    },
    {
     "pointer/set": "/aux/part_labels",
     "value": 1
    },
    {
     "pointer/set": "/input/gpu",
     "value": 1
    }
   ],
   "duration": "PT1M",
   "duration_basis": "estimate: Segment alone took 6 to 12 s on the pony example; this adds the garment render and the maps",
   "description": "Run Alchemy3D-Segment with maps from the part detector.",
   "description_basis": "written: the sentence the domain description gives for this action"
  },
  "close-labelling": {
   "params": [],
   "body": [
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/aux/metric_labels",
      "value": 1
     }
    },
    {
     "pointer/set": "/aux/labelled_parts",
     "value": 1
    }
   ],
   "duration": "PT0S",
   "duration_basis": "composite marker",
   "description": "Needs metric labels. Makes labelled parts.",
   "description_basis": "drafted from the action's own preconditions and effects; no other source"
  },
  "ingest-usd": {
   "params": [],
   "body": [
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/aux/source_mesh",
      "value": 1
     }
    },
    {
     "pointer/set": "/aux/usd_stage",
     "value": 1
    }
   ],
   "duration": "PT0.658S",
   "duration_basis": "measured: warm median 0.658 s of 5 runs, to the millisecond; the first run took 0.646 s. Wall clock of tools/aux.sh action ingest-usd on fedora, which includes process and model start-up",
   "measured": {
    "runs_s": [
     0.646,
     0.658,
     0.645,
     0.643,
     0.672,
     0.672
    ],
    "host": "node-1w7jr9qmdnujmtqxifhewsfsn.ipv6.telus.net, RTX 4090, tools/measure/time_actions.py, 2026-11-15"
   },
   "description": "Needs source mesh. Makes usd stage.",
   "description_basis": "drafted from the action's own preconditions and effects; no other source"
  },
  "restore-units": {
   "params": [],
   "body": [
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/aux/part_labels",
      "value": 1
     }
    },
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/aux/scale_sidecar",
      "value": 1
     }
    },
    {
     "pointer/set": "/aux/metric_labels",
     "value": 1
    }
   ],
   "duration": "PT0.741S",
   "duration_basis": "measured: warm median 0.741 s of 5 runs, to the millisecond; the first run took 0.741 s. Wall clock of tools/aux.sh action restore-units on fedora, which includes process and model start-up",
   "measured": {
    "runs_s": [
     0.741,
     0.739,
     0.739,
     0.741,
     0.744,
     0.765
    ],
    "host": "node-1w7jr9qmdnujmtqxifhewsfsn.ipv6.telus.net, RTX 4090, tools/measure/time_actions.py, 2026-11-15"
   },
   "description": "Needs part labels and scale sidecar. Makes metric labels.",
   "description_basis": "drafted from the action's own preconditions and effects; no other source"
  }
 },
 "methods": {
  "/aux/coco_relabelled": {
   "alternatives": [
    {
     "name": "relabel-coco",
     "subtasks": [
      [
       "relabel-coco"
      ]
     ]
    }
   ]
  },
  "/aux/synth_set": {
   "alternatives": [
    {
     "name": "make-synth-set",
     "subtasks": [
      [
       "make-synth-set"
      ]
     ]
    }
   ]
  },
  "/aux/part_detector": {
   "alternatives": [
    {
     "name": "train-part-detector",
     "subtasks": [
      [
       "goal",
       "/aux/coco_relabelled"
      ],
      [
       "goal",
       "/aux/synth_set"
      ],
      [
       "train-part-detector"
      ]
     ]
    }
   ]
  },
  "/aux/unit_cube_source": {
   "alternatives": [
    {
     "name": "unitise",
     "subtasks": [
      [
       "goal",
       "/aux/usd_stage"
      ],
      [
       "unitise-source"
      ]
     ]
    }
   ]
  },
  "/aux/scale_sidecar": {
   "alternatives": [
    {
     "name": "sidecar",
     "subtasks": [
      [
       "goal",
       "/aux/unit_cube_source"
      ],
      [
       "write-scale-sidecar"
      ]
     ]
    }
   ]
  },
  "/aux/part_labels": {
   "alternatives": [
    {
     "name": "segment-labels",
     "subtasks": [
      [
       "goal",
       "/aux/part_detector"
      ],
      [
       "goal",
       "/aux/unit_cube_source"
      ],
      [
       "segment-labels"
      ]
     ]
    }
   ]
  },
  "/aux/labelled_parts": {
   "alternatives": [
    {
     "name": "label-parts",
     "subtasks": [
      [
       "goal",
       "/aux/metric_labels"
      ],
      [
       "close-labelling"
      ]
     ]
    }
   ]
  },
  "/aux/usd_stage": {
   "alternatives": [
    {
     "name": "ingest",
     "subtasks": [
      [
       "goal",
       "/aux/source_mesh"
      ],
      [
       "ingest-usd"
      ]
     ]
    }
   ]
  },
  "/aux/metric_labels": {

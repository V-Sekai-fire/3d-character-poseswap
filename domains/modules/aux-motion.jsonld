{
 "@context": {
  "VSEKAI": "https://v-sekai.org/",
  "domain": "VSEKAI:planning/domain/"
 },
 "@type": "domain:Module",
 "name": "aux-motion",
 "module": {
  "summary": "Which parts are soft and which rigid: build Warp, measure motion lag and classify, or, when no body clip or drape is on hand, classify from the class prior."
 },
 "variables": [
  {
   "name": "input",
   "type": "int",
   "description": "1 when an input is on hand: a double-precision Godot editor, the packet golden file, the MuJoCo guest, the 100 Hz clips, the ANNY base mesh, the SOMA phenotype data, the built ANNY fit guest ELF, the OmniGen2 guest ELF built with only the mul_mat op, the full OmniGen2 guest ELF, a free GPU host, an edit prompt; for the AUX route: a Fashionpedia-class COCO set, the GarmentCodeData drapes, the Segment weights, SAM 3 and DINOv3 weights checked against their pinned SHA-256, a host C++ compiler the CUDA toolkit accepts, a body motion clip, a portrait.",
   "init": {
    "gpu": 0
   }
  },
  {
   "name": "aux",
   "type": "int",
   "description": "1 when a step of the AUX part-labelling and rigging route is done: coco_relabelled, synth_set, part_detector, unit_cube_source, part_labels, warp_built, motion_lag, hair_cards, spring_chains, scale_sidecar; composites labelled_parts, soft_rigid_known and rigged; also usd_stage (the source ingested into OpenUSD in its own units) and metric_labels (Segment's labels put back on the real-size stage by restore-units).",
   "init": {}
  }
 ],
 "actions": {
  "build-warp": {
   "params": [],
   "body": [
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/input/host_cxx_ok",
      "value": 1
     }
    },
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/input/gpu_host",
      "value": 1
     }
    },
    {
     "pointer/set": "/aux/warp_built",
     "value": 1
    }
   ],
   "duration": "PT30M",
   "duration_basis": "estimate: not built yet; blocked on the host compiler",
   "description": "Build the NvidiaWarp-GarmentCode fork.",
   "description_basis": "written: the sentence the domain description gives for this action"
  },
  "measure-motion-lag": {
   "params": [],
   "body": [
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/input/gpu",
      "value": 1
     }
    },
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/aux/part_labels",
      "value": 1
     }
    },
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/aux/warp_built",
      "value": 1
     }
    },
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/input/body_motion_clip",
      "value": 1
     }
    },
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/input/gcd_drapes",
      "value": 1
     }
    },
    {
     "pointer/set": "/aux/motion_lag",
     "value": 1
    },
    {
     "pointer/set": "/input/gpu",
     "value": 1
    }
   ],
   "duration": "PT1H",
   "duration_basis": "estimate: not built yet",
   "description": "Drape, move the body, and measure which vertices lag.",
   "description_basis": "written: the sentence the domain description gives for this action"
  },
  "classify-soft-rigid": {
   "params": [],
   "body": [
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/aux/labelled_parts",
      "value": 1
     }
    },
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/aux/motion_lag",
      "value": 1
     }
    },
    {
     "pointer/set": "/aux/soft_rigid_known",
     "value": 1
    }
   ],
   "duration": "PT1S",
   "duration_basis": "estimate",
   "description": "Needs labelled parts and motion lag. Makes soft rigid known.",
   "description_basis": "drafted from the action's own preconditions and effects; no other source"
  },
  "classify-by-class-prior": {
   "body": [
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/aux/labelled_parts",
      "value": 1
     }
    },
    {
     "pointer/set": "/aux/soft_rigid_known",
     "value": 1
    },
    {
     "pointer/set": "/aux/soft_rigid_prior_only",
     "value": 1
    }
   ],
   "duration": "PT1S",
   "duration_basis": "estimate: the table in tests/evidence/class_motion_counts.json decides soft, rigid or parent for each class whose motion covers 80% of its annotations (Skirt and Cape soft, Detail parent, Accessory and Fitted rigid) and leaves Collar and Sleeve as measure, which only the lag measurement settles. A lookup in a table of 7 classes; the script that once timed it at 0.02 s was removed, so no run backs the PT1S and the action has no code yet",
   "description": "Needs labelled parts. Makes soft rigid known and soft rigid prior only.",
   "description_basis": "drafted from the action's own preconditions and effects; no other source"
  }
 },
 "methods": {
  "/aux/warp_built": {
   "alternatives": [
    {
     "name": "build-warp",
     "subtasks": [
      [
       "build-warp"
      ]
     ]
    }
   ]
  },
  "/aux/motion_lag": {
   "alternatives": [
    {
     "name": "measure-lag",
     "subtasks": [
      [
       "goal",
       "/aux/part_labels"
      ],
      [
       "goal",
       "/aux/warp_built"
      ],
      [
       "measure-motion-lag"
      ]
     ]
    }
   ]
  },
  "/aux/soft_rigid_known": {
   "alternatives": [
    {
     "name": "decide-soft-or-rigid",
     "subtasks": [
      [
       "goal",
       "/aux/labelled_parts"
      ],
      [
       "goal",
       "/aux/motion_lag"
      ],
      [
       "classify-soft-rigid"
      ]
     ]
    },
    {
     "name": "decide-by-class-prior",
     "subtasks": [
      [
       "goal",
       "/aux/labelled_parts"
      ],
      [
       "classify-by-class-prior"
      ]
     ]
    }
   ]
  }
 }
}

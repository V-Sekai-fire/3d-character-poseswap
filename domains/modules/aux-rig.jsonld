{
 "@context": {
  "VSEKAI": "https://v-sekai.org/",
  "domain": "VSEKAI:planning/domain/"
 },
 "@type": "domain:Module",
 "name": "aux-rig",
 "module": {
  "summary": "Hair cards and spring chains from a portrait, then rig the parts."
 },
 "variables": [
  {
   "name": "input",
   "type": "int",
   "description": "1 when an input is on hand: a double-precision Godot editor, the packet golden file, the MuJoCo guest, the 100 Hz clips, the ANNY base mesh, the SOMA phenotype data, the built ANNY fit guest ELF, the OmniGen2 guest ELF built with only the mul_mat op, the full OmniGen2 guest ELF, a free GPU host, an edit prompt; for the AUX route: a Fashionpedia-class COCO set, the GarmentCodeData drapes, the Segment weights, SAM 3 and DINOv3 weights checked against their pinned SHA-256, a host C++ compiler the CUDA toolkit accepts, a body motion clip, a portrait.",
   "init": {
    "gpu": 0
   }
  },
  {
   "name": "aux",
   "type": "int",
   "description": "1 when a step of the AUX part-labelling and rigging route is done: coco_relabelled, synth_set, part_detector, unit_cube_source, part_labels, warp_built, motion_lag, hair_cards, spring_chains, scale_sidecar; composites labelled_parts, soft_rigid_known and rigged; also usd_stage (the source ingested into OpenUSD in its own units) and metric_labels (Segment's labels put back on the real-size stage by restore-units).",
   "init": {}
  }
 ],
 "actions": {
  "make-hair-cards": {
   "params": [],
   "body": [
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/input/portrait",
      "value": 1
     }
    },
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/input/sam3_dinov3_verified",
      "value": 1
     }
    },
    {
     "pointer/set": "/aux/hair_cards",
     "value": 1
    }
   ],
   "duration": "PT21.082S",
   "duration_basis": "measured: warm median 21.082 s of 3 runs, to the millisecond; the first run took 21.851 s. Wall clock of tools/aux.sh action make-hair-cards on fedora, which includes process and model start-up",
   "measured": {
    "runs_s": [
     21.851,
     21.07,
     21.082,
     21.084
    ],
    "host": "node-1w7jr9qmdnujmtqxifhewsfsn.ipv6.telus.net, RTX 4090, tools/measure/time_actions.py, 2026-11-15"
   },
   "description": "HairDeck: portrait to hair cards on Apple MPS.",
   "description_basis": "written: the sentence the domain description gives for this action"
  },
  "make-spring-chains": {
   "params": [],
   "body": [
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/aux/hair_cards",
      "value": 1
     }
    },
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/aux/scale_sidecar",
      "value": 1
     }
    },
    {
     "pointer/set": "/aux/spring_chains",
     "value": 1
    }
   ],
   "duration": "PT2S",
   "duration_basis": "measured: 1.3 s inside the same HairDeck run",
   "description": "HairDeck chain model: path, joints and stiffness per chain, in the normalised frame.",
   "description_basis": "written: the sentence the domain description gives for this action"
  },
  "rig-aux-parts": {
   "params": [],
   "body": [
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/aux/labelled_parts",
      "value": 1
     }
    },
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/aux/soft_rigid_known",
      "value": 1
     }
    },
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/aux/spring_chains",
      "value": 1
     }
    },
    {
     "pointer/set": "/aux/rigged",
     "value": 1
    }
   ],
   "duration": "PT1M",
   "duration_basis": "estimate: not built yet",
   "description": "Give soft parts spring-bone chains and rigid parts a parent bone, from the labels and the measured lag.",
   "description_basis": "written: the sentence the domain description gives for this action"
  }
 },
 "methods": {
  "/aux/hair_cards": {
   "alternatives": [
    {
     "name": "make-hair-cards",
     "subtasks": [
      [
       "make-hair-cards"
      ]
     ]
    }
   ]
  },
  "/aux/spring_chains": {
   "alternatives": [
    {
     "name": "make-spring-chains",
     "subtasks": [
      [
       "goal",
       "/aux/hair_cards"
      ],
      [
       "goal",
       "/aux/scale_sidecar"
      ],
      [
       "make-spring-chains"
      ]
     ]
    }
   ]
  },
  "/aux/rigged": {
   "alternatives": [
    {
     "name": "rig-parts",
     "subtasks": [
      [
       "goal",
       "/aux/labelled_parts"
      ],
      [
       "goal",
       "/aux/soft_rigid_known"
      ],
      [
       "goal",
       "/aux/spring_chains"
      ],
      [
       "rig-aux-parts"
      ]
     ]
    }
   ]
  }
 }
}

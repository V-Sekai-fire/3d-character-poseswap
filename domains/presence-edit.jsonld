   "duration_basis": "measured: 360 garments on fedora, 2026-11-15"
  },
  "train-part-detector": {
   "params": [],
   "body": [
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/aux/coco_relabelled",
      "value": 1
     }
    },
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/aux/synth_set",
      "value": 1
     }
    },
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/input/gpu_host",
      "value": 1
     }
    },
    {
     "pointer/set": "/aux/part_detector",
     "value": 1
    }
   ],
   "duration": "PT19M24S",
   "duration_basis": "measured: 15 epochs on the 3-class set, one RTX 4090"
  },
  "unitise-source": {
   "params": [],
